# Server Binding (Cloud PaaS platforms automatically set PORT)
ARSENAL_HOST=0.0.0.0
ARSENAL_PORT=8080

# Persistent Storage Paths (mount /app/data in Docker)
ARSENAL_DATA_DIR=./data
ARSENAL_DB=./data/arsenal.db
ARSENAL_VAULT_DB=./data/vault.db
ARSENAL_REPORTS_DIR=./reports
ARSENAL_LOGS_DIR=./logs
ARSENAL_PLUGINS=./plugins

# Security & Auth
# Generate a strong random key in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
ARSENAL_JWT_SECRET=
ARSENAL_DEFAULT_KEYS=
ARSENAL_CORS=*
# Optional bootstrap admin account (set strong credentials in production)
ARSENAL_ADMIN_EMAIL=
ARSENAL_ADMIN_PASSWORD=
ARSENAL_REQUIRE_AUTH=0
ARSENAL_ALLOW_REGISTRATION=1
ARSENAL_ALLOW_GOOGLE_AUTH=1
ARSENAL_COOKIE_SECURE=0

# Optional Third-Party Intelligence API Keys
HIBP_API_KEY=
GEMINI_API_KEY=

# Performance & Limits
ARSENAL_RATE_LIMIT=60
ARSENAL_RATE_WINDOW=60
ARSENAL_TIMEOUT=10
ARSENAL_CONCURRENCY=25
ARSENAL_CACHE_TTL=600
